<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".view.activities.MainViewActivity">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/jetbrainsmonoextrabold"
        android:text="@string/update_update"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backButton" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp">

            <!-- Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_name"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/jetbrainsmonobold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>
            
            <EditText
                android:id="@+id/nameInput2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="@color/background_secondary"
                android:fontFamily="@font/jetbrainsmonoregular"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- Email Input Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_email"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/jetbrainsmonobold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                
                <EditText
                    android:id="@+id/emailInput2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_input"
                    android:backgroundTint="@color/background_secondary"
                    android:fontFamily="@font/jetbrainsmonoregular"
                    android:inputType="textEmailAddress"
                    android:paddingEnd="56dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/copyButtonEmail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_copy"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <!-- Password Input Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_password"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/jetbrainsmonobold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                
                <EditText
                    android:id="@+id/passwordInput2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_input"
                    android:backgroundTint="@color/background_secondary"
                    android:fontFamily="@font/jetbrainsmonoregular"
                    android:inputType="textPassword"
                    android:paddingEnd="100dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/passwordVisibilityButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_visibility_on"
                        app:tint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/copyButtonPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/btn_copy"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </FrameLayout>

            <!-- Folder Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Folder"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/jetbrainsmonobold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <Spinner
                android:id="@+id/folderSpinner2"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="@color/background_secondary"
                android:popupBackground="@color/background_secondary"
                android:layout_marginBottom="40dp" />

            <!-- Action Buttons (Update, Duplicate, Delete) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="24dp">
                
                <!-- Update Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/updateButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rounded_input"
                        android:backgroundTint="@color/background_secondary"
                        android:gravity="center"
                        android:fontFamily="@font/jetbrainsmonobold"
                        android:text="@string/update_btn_update"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="4dp"
                        android:elevation="2dp" />
                </FrameLayout>

                <!-- Duplicate Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp">

                    <TextView
                        android:id="@+id/duplicateButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rounded_input"
                        android:backgroundTint="@color/background_secondary"
                        android:gravity="center"
                        android:fontFamily="@font/jetbrainsmonobold"
                        android:text="[duplicate]"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="4dp"
                        android:elevation="2dp" />
                </FrameLayout>

                <!-- Delete Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/deleteButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rounded_input"
                        android:backgroundTint="#FFEBEE"
                        android:gravity="center"
                        android:fontFamily="@font/jetbrainsmonobold"
                        android:text="@string/update_btn_delete"
                        android:textColor="#D32F2F"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingHorizontal="4dp"
                        android:elevation="2dp" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>