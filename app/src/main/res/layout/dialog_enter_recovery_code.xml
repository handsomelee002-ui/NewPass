<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_recovery_key"
        android:fontFamily="@font/jetbrainsmonobold"
        android:textSize="18sp"
        android:textColor="@color/recovery_dialog_text"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Recovery key input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/recovery_key_hint"
        android:layout_marginBottom="12dp"
        android:textColorHint="@color/recovery_dialog_hint"
        app:hintTextColor="@color/recovery_dialog_hint"
        app:hintTextAppearance="@style/RecoveryDialogHintText"
        app:boxStrokeColor="@color/recovery_dialog_line">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_recovery_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmonoregular"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:textColor="@color/recovery_dialog_text"
            android:textColorHint="@color/recovery_dialog_hint"
            android:backgroundTint="@color/recovery_dialog_line" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- New password -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_the_new_password"
        android:layout_marginBottom="12dp"
        android:textColorHint="@color/recovery_dialog_hint"
        app:hintTextColor="@color/recovery_dialog_hint"
        app:hintTextAppearance="@style/RecoveryDialogHintText"
        app:boxStrokeColor="@color/recovery_dialog_line">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_new_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/recovery_dialog_text"
            android:textColorHint="@color/recovery_dialog_hint"
            android:backgroundTint="@color/recovery_dialog_line" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm new password -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/reenter_the_new_password"
        android:layout_marginBottom="20dp"
        android:textColorHint="@color/recovery_dialog_hint"
        app:hintTextColor="@color/recovery_dialog_hint"
        app:hintTextAppearance="@style/RecoveryDialogHintText"
        app:boxStrokeColor="@color/recovery_dialog_line">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/recovery_dialog_text"
            android:textColorHint="@color/recovery_dialog_hint"
            android:backgroundTint="@color/recovery_dialog_line" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/recovery_loading_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/accent"
            android:indeterminateTintMode="src_in" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/jetbrainsmonobold"
            android:text="@string/verifying"
            android:textColor="@color/recovery_dialog_text"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_wipe_vault"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:minWidth="96dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/wipe_vault"
            android:fontFamily="@font/jetbrainsmonobold"
            android:textSize="12sp"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_cancel_recovery"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:minWidth="96dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cancel"
            android:fontFamily="@font/jetbrainsmonobold"
            android:textSize="12sp"
            android:backgroundTint="@color/background_secondary"
            android:textColor="@color/recovery_dialog_text"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_confirm_recovery"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:minWidth="96dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/confirm"
            android:fontFamily="@font/jetbrainsmonobold"
            android:textSize="12sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/background_primary" />

    </LinearLayout>

</LinearLayout>
